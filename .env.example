# Copy to .env and fill in your values. Never commit .env.
# On the Raspberry Pi, keep these in /etc/piagent/env instead (see docs/setup.md).

# Required
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
COMPOSIO_API_KEY=
COMPOSIO_CONNECTED_ACCOUNT_ID=

# Optional: YouTube Data API v3 key. Without it, the bot has no YouTube search tool.
YOUTUBE_API_KEY=

# Optional paths for local runs. Defaults: /etc/piagent/users.toml,
# /home/piagent/data/agent.db, and /home/piagent/logs.
PIAGENT_USERS_FILE=./users.toml
PIAGENT_DB_PATH=./agent.db
PIAGENT_LOG_DIR=./logs

# Backup script only (backup/backup.py). Keep these out of the bot's environment.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# BACKUP_FOLDER_ID=
# BACKUP_PASSPHRASE=
